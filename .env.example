VITE_DATA_MODE=demo
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Product analytics (PostHog) — OPTIONAL. Without it, all product events safely
# no-op and posthog-js is never loaded. Use ONLY the public PostHog project API
# key (starts with "phc_") — never a personal/secret API key. Product-interaction
# events (campaign support, votes, questions, search, etc.) are sent to PostHog
# only when this is set. Aggregate page/traffic analytics are handled separately
# by Vercel Web Analytics (see below), which needs no key.
VITE_POSTHOG_KEY=
# PostHog ingestion host (public). Override only for EU/self-hosted PostHog.
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Vercel Web Analytics needs NO application secret or env var. It is enabled
# manually in the Vercel project dashboard (Project → Analytics → Web Analytics)
# and begins reporting after a deployment and real page visits. It measures
# aggregate traffic only (page views, visitors, routes, referrers, devices) —
# custom product events are NOT sent to Vercel.
# Absolute origin used for auth email redirects (email verification + password
# reset) and canonical links.
# Local development: http://localhost:5173
# Vercel production MUST set: VITE_SITE_URL=https://open-floor.ca
# Must be a full absolute URL (scheme + host, no trailing slash) — never the
# literal string "VITE_SITE_URL". If unset/invalid, the app falls back to the
# runtime origin and logs an error in production.
VITE_SITE_URL=http://localhost:5173
# Public contact email shown on the Contact page and in legal documents.
# Defaults to an obvious placeholder if unset — set the real address before launch.
VITE_CONTACT_EMAIL=
# Cloudflare Turnstile PUBLIC site key. Required in production: the intake Edge
# Function fails CLOSED, so if TURNSTILE_SECRET_KEY is set server-side but this is
# absent, the forms render no challenge and every submission is rejected.
VITE_TURNSTILE_SITE_KEY=
# Short git SHA of the build, set by the deployment platform. Purely diagnostic:
# /admin/system names the running build, and public bug reports record it so a
# report can be tied to a specific deploy. Absent = /admin/system says "Unknown"
# (which is truthful, but unhelpful when diagnosing). On Vercel, set it to
# $VERCEL_GIT_COMMIT_SHA in the project's environment variables.
VITE_APP_COMMIT=

# --- Supabase Edge Function secrets (server-side; NEVER a VITE_ var) ---
# Set with `supabase secrets set NAME=value`. Listed here BY NAME ONLY — never
# commit a value. See docs/admin-communications.md for what each one does and what
# breaks without it.
#   RESEND_API_KEY          REQUIRED  transactional email (starts "re_")
#   RESEND_WEBHOOK_SECRET   REQUIRED  Svix signing secret (starts "whsec_")
#   TURNSTILE_SECRET_KEY    REQUIRED  captcha verification; intake fails closed without it
#   INTAKE_FUNCTION_SECRET  REQUIRED  lets submit-intake call send-transactional-email
#   ADMIN_ALERT_EMAIL       optional  where new-submission alerts go
#   EMAIL_SENDER            optional  defaults to "Open Floor <no-reply@open-floor.ca>"
#   EMAIL_REPLY_SUPPORT     optional  defaults to support@open-floor.ca
#   EMAIL_REPLY_BUGS        optional  defaults to bugs@open-floor.ca
#   EMAIL_REPLY_PRIVACY     optional  defaults to privacy@open-floor.ca
#   EMAIL_REPLY_CONTACT     optional  defaults to contact@open-floor.ca
#   ALLOWED_ORIGIN          optional  defaults to "*"; set to the production origin

# --- Server-side tooling ONLY (never a VITE_ var; never in frontend code) ---
# The service-role key is used by the security-verification scripts
# (verify:core-security / verify:rpc-security / verify:admin-security) and the
# one-time password-setup mailer (scripts/send-password-setup-emails.ts). It is
# also the `login` Edge Function's secret. NEVER expose it to the browser and
# NEVER commit a real value. Point these at a SCRATCH project for verification.
#   SUPABASE_URL=https://<project-ref>.supabase.co
#   SUPABASE_ANON_KEY=<anon-key>
#   SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
#   SITE_URL=https://www.open-floor.ca   # used by the password-setup mailer

# --- Phase 2 (company-universe live sync) — NOT USED YET ---
# These are placeholders for the SEC/FMP provider integration, sync Edge
# Function, and admin dashboard described in docs/company-universe.md as
# future work. No code in this repository reads them today. Do not set them
# expecting any behavior to change — see docs/company-universe.md for status.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PROJECT_REF=
# SUPABASE_FUNCTION_URL=
# FMP_API_KEY=
# FMP_BASE_URL=https://financialmodelingprep.com/stable
# SEC_COMPANY_DIRECTORY_URL=https://www.sec.gov/files/company_tickers_exchange.json
# SEC_USER_AGENT="Open Floor admin@example.com"
# COMPANY_SYNC_SECRET=
# PUBLIC_DISPLAY_FMP_ENRICHMENT=false
